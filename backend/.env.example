# Environment configuration
ENVIRONMENT=production
PROJECT_NAME="Apex Automotive Blueprint API"
DEBUG=False

# Managed PostgreSQL (Neon, Supabase, Cloud SQL, Railway, Render)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?ssl=require

# SQLite fallback for local development
# DATABASE_URL=sqlite+aiosqlite:///./app.db

# Allowed CORS origins separated by comma (supports local + vercel domains)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://apex-blueprint.vercel.app

# Google Gemini API Key for Multimodal CAD/Schematic Extraction
GEMINI_API_KEY=your_gemini_api_key_here
